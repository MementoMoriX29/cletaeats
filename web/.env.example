# Opcional. Por defecto la web llama a /api en su mismo dominio (producción con Caddy)
# y en desarrollo Vite redirige /api a http://localhost:3000.
# Solo definilo si la API está en otro dominio:
# VITE_API_URL=https://api.ejemplo.com/api

# Modo demostración (activado por defecto): pagos simulados, cuentas de prueba en el login, llamadas desactivadas
# y un botón para simular el recorrido del repartidor.
# En una instalación real con pasarela de pago: VITE_DEMO=false
# VITE_DEMO=false
