# Copiá este archivo a .env y completá los valores. El .env nunca se sube al repo.

NODE_ENV=development
PORT=3000

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cletaeats
DB_PASSWORD=
DB_NAME=cletaeats

# Secreto para firmar los JWT (mínimo 32 caracteres). Generalo con: openssl rand -base64 48
JWT_SECRET=

# Orígenes web permitidos por CORS, separados por coma (en desarrollo, localhost ya está permitido)
CORS_ORIGINS=http://localhost:5173

# Administrador. La contraseña va como hash bcrypt: npm run hash-password -- "tu-contraseña"
ADMIN_EMAIL=admin@cletaeats.local
ADMIN_PASSWORD_HASH=
