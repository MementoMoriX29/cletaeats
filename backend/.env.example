# Copiá este archivo a .env y completá los valores. El .env nunca se sube al repo.

NODE_ENV=development
PORT=3000

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cletaeats
DB_PASSWORD=
DB_NAME=cletaeats

# Secreto para firmar las sesiones (mínimo 32 caracteres). Generalo con: openssl rand -base64 48
JWT_SECRET=

# Orígenes web permitidos por CORS, separados por coma (en desarrollo, localhost ya está permitido)
CORS_ORIGINS=http://localhost:5173

# Opcionales (estos son los valores por defecto)
# JWT_EXPIRES_IN=7d
# BCRYPT_ROUNDS=12
# PENDING_ORDER_TIMEOUT_MIN=15

# La cuenta de soporte no va acá: se crea con  npm run create-admin -- correo "Nombre"
